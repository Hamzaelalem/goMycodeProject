# Optional overrides — Next.js loads `.env.local` first; Prisma CLI uses `env-cmd -f config/database.env`.
# Default dev URL is committed in `config/database.env` (Docker Compose on port 5433).
#
# Production: set DATABASE_URL in the host environment or `.env.production.local` only on the server.
#
# Custom Postgres (not Docker):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mydb?schema=public"

# ---------------------------------------------------------------------------
# AI Assistant — Ollama (local open-source LLM)
# ---------------------------------------------------------------------------
# Ollama must be running locally: https://ollama.com
# Pull the model first: ollama pull llama3.2
#
# Default base URL (Ollama's default port):
# OLLAMA_BASE_URL=http://localhost:11434
#
# Model to use — swap to any model you have pulled, e.g.:
#   llama3.2        (default, ~2GB, fast)
#   mistral         (~4GB, strong analytical quality)
#   qwen2.5:7b      (~4.5GB, excellent reasoning)
#   phi4-mini       (~2.5GB, best for CPU-only machines)
# OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Shared-password access gate (REQUIRED to use the app)
# ---------------------------------------------------------------------------
# The whole app (pages + API routes) is gated by a single access password via
# proxy.ts. Both variables must be set, or every request is blocked and login
# returns 500. There is no per-user identity — the password grants full access.
#
#   AUTH_PASSWORD  the shared access password users type on /login
#   AUTH_SECRET    HMAC key that signs the session cookie — keep it secret and
#                  stable (rotating it invalidates all active sessions).
#                  Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AUTH_PASSWORD=change-me
# AUTH_SECRET=replace-with-a-long-random-hex-string
